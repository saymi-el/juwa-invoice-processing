        "totalHt": 90, "vatRate": 20, "vatAmount": 18, "totalTtc": 110
      },
      "expected": {"allowedStatuses": ["review"], "checks": [
        {"code": "LINE_TOTAL", "field": "items.0.lineTotal", "status": "fail", "expected": 62.5, "actual": 50, "difference": -12.5},
        {"code": "COMPUTED_SUM_HT", "field": "totalHt", "status": "fail", "expected": 102.5, "actual": 90, "difference": -12.5},
        {"code": "HT_TAX_TTC", "field": "totalTtc", "status": "fail", "expected": 108, "actual": 110, "difference": 2}
      ]},
      "layout": {"style": "blue"}
    },
