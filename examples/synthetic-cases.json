      "scenario": "Facture cohérente : quantité décimale, petit montant et prix unitaire à trois décimales.",
      "invoice": {
        "supplier": "ATELIER TEST ALPHA", "invoiceNumber": "SYN-001", "date": "2026-10-10", "currency": "EUR",
        "items": [
          {"description": "Découpe de panneau", "quantity": 1.5, "unitPrice": 19.9, "lineTotal": 29.85},
          {"description": "Rondelle acier", "quantity": 3, "unitPrice": 0.1, "lineTotal": 0.3},
          {"description": "Joint de précision", "quantity": 2, "unitPrice": 2.675, "lineTotal": 5.35}
        ],
        "totalHt": 35.5, "vatRate": 20, "vatAmount": 7.1, "totalTtc": 42.6
      },
      "expected": {"allowedStatuses": ["ok"], "checks": []},
      "layout": {"style": "green", "note": "Quantités exprimées à l'unité, sauf la découpe facturée au mètre."}
    },
    {
      "fileName": "test_02_calculs_errones.pdf",
